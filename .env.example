# Copy this file to .env before running `docker compose up`.
# .env is gitignored — never commit real credentials.

# --- Postgres (Airflow metadata DB) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW__CORE__FERNET_KEY=
# Must be identical for webserver and scheduler, or the UI gets 403 when fetching
# task logs. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_RAW=raw
MINIO_BUCKET_PROCESSED=processed
# MinIO images (default: quay.io/minio/minio + quay.io/minio/mc). Use minio/minio + minio/mc
# (Docker Hub) if quay.io returns 401/unreachable.
# MINIO_IMAGE=minio/minio
# MINIO_MC_IMAGE=minio/mc

# --- ClickHouse ---
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DB=default

# --- Superset ---
# Random default below is fine for local dev; Superset refuses to start with
# its own well-known placeholder secret, so this can't be left blank.
SUPERSET_SECRET_KEY=s7HSZ0ho8Q+Mo5a+Ti52xMZ52FYHQ3IzNf2bPi4X0WS4aXmYxxazl+7o
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=User
SUPERSET_ADMIN_EMAIL=admin@example.com

# --- Logistics DWH (dags/logistics_dwh_daily.py, dags/logistics_bootstrap.py, spark-streaming) ---
# ClickHouse is the warehouse only: the star schema goes to DWH_TARGET_DB.
# Raw data lives in MinIO (bucket MINIO_BUCKET_RAW): csv/ (uploaded CSVs),
# history/<table>/partition_date=.../ (bootstrap) and logistics/<table>/... (streaming).
DWH_CH_URL=https://<host>:8443
DWH_CH_USER=default
DWH_CH_PASSWORD=
DWH_TARGET_DB=dwh

# --- Streaming (docker/streamgen, docker/kafka, spark-streaming) ---
# Simulated event rate: trips per second (each trip also emits 2 delivery events,
# 1-2 fuel purchases, rarely an incident) and independent maintenance records per minute.
STREAMGEN_TRIPS_PER_SECOND=1
STREAMGEN_MAINTENANCE_PER_MINUTE=3
